# Template. Install to /etc/doc-rag.env (root:root 0644 — no secrets here).
# Read by doc-rag-api.service via EnvironmentFile.

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

QDRANT_URL=http://localhost:6333
COLLECTION=docs

# Built React frontend. Absolute path in production: the default
# (../frontend/dist) is relative to WorkingDirectory, and a wrong path fails
# silently with a bare 404 at / rather than an error in the log.
WEB_DIR=/home/ai/scripts/rag/frontend/dist

# Must comfortably hold TOP_K chunks plus the prompt. Too small and Ollama
# silently truncates the context, producing confident wrong answers.
NUM_CTX=16384
TOP_K=5

# Qwen3 thinking mode: 1 to enable (slower, better multi-hop reasoning).
THINK=0

# 1 to disable the full-text pass and use dense retrieval only.
NO_KEYWORD=0
